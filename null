        function openModal(serviceId) {
            const s = servicesData.find(item => item.id === serviceId);
            if (!s) return;

            document.getElementById('modal-icon').innerText = s.icon;
            document.getElementById('modal-title').innerText = s.name;
            document.getElementById('modal-container-name').innerText = 'Container: ' + s.id;
            document.getElementById('modal-description').innerText = s.description;
            document.getElementById('modal-port').innerText = s.port;
            document.getElementById('modal-internal-url').innerText = s.internal_url;

            const accessBtn = document.getElementById('modal-access-btn');
            if (s.has_ui) {
                accessBtn.href = s.url;
                accessBtn.classList.remove('hidden');
            } else {
                accessBtn.classList.add('hidden');
            }

            document.getElementById('service-modal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('service-modal').classList.add('hidden');
        }

        async function checkHealth() {
            const syncIcon = document.getElementById('sync-icon');
            syncIcon.classList.add('animate-spin');

            try {
                const res = await fetch('/api/status');
                const statusMap = await res.json();
                
                for (const [id, status] of Object.entries(statusMap)) {
                    const badge = document.getElementById(`badge-${id}`);
                    if (badge) {
                        if (status === 'online') {
                            badge.className = 'status-badge px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex items-center gap-1';
                            badge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> ATIVO';
                        } else {
                            badge.className = 'status-badge px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider rounded-full bg-rose-500/10 text-rose-400 border border-rose-500/20 flex items-center gap-1';
                            badge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span> INATIVO';
                        }
                    }
                }
            } catch (e) {
                console.error("Erro ao verificar status dos serviços", e);
            } finally {
                syncIcon.classList.remove('animate-spin');
            }
        }

        // Checagem inicial
        checkHealth();
