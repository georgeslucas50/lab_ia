# Modelo de variáveis. O instalador gera segredos aleatórios em .env.
# Não use este arquivo diretamente em ambientes compartilhados.
POSTGRES_USER=aluno
POSTGRES_PASSWORD=SUBSTITUA_POR_SEGREDO_ALEATORIO

LITELLM_MASTER_KEY=sk-local-SUBSTITUA_POR_SEGREDO_ALEATORIO
LITELLM_SALT_KEY=SUBSTITUA_POR_SEGREDO_ALEATORIO

NEO4J_AUTH=neo4j/SUBSTITUA_POR_SEGREDO_ALEATORIO

N8N_ENCRYPTION_KEY=SUBSTITUA_POR_SEGREDO_ALEATORIO
FLOWISE_SECRET_KEY=SUBSTITUA_POR_SEGREDO_ALEATORIO
BROWSERLESS_TOKEN=SUBSTITUA_POR_SEGREDO_ALEATORIO
JUPYTER_TOKEN=SUBSTITUA_POR_SEGREDO_ALEATORIO

WHISPER_MODEL=Systran/faster-whisper-small

# Gerado automaticamente pelo instalador; mantenha somente no .env local.
UPDATER_TOKEN=
# Opcional: token somente para atualizar um repositório GitHub privado via HTTPS.
GITHUB_TOKEN=
